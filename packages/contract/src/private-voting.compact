import CompactStandardLibrary;

export struct VotingBox {
  proposals: Map<Field, Counter>;
  voterCommitments: MerkleTree<20, Field>;
  nullifiers: Set<Field>;
  votingOpen: Boolean;
}

export ledger voting: VotingBox;

constructor(open: Boolean) {
  voting.votingOpen = open;
}

export circuit registerVoter(voterSecret: Field): [] {
  assert(voting.votingOpen, "Registration is closed");
  const commitment = transientHash<Field>(voterSecret);
  voting.voterCommitments.insert(commitment);
}

export circuit castVote(
  voterSecret: Field,
  authPath: MerkleTreePath<20, Field>,
  proposalId: Field,
): [] {
  assert(voting.votingOpen, "Voting is closed");
  const commitment = transientHash<Field>(voterSecret);
  const digest = merkleTreePathRoot<20, Field>(authPath);
  assert(voting.voterCommitments.checkRoot(digest) == true, "Voter not registered");
  const nullifier = transientHash<Vector<2, Field>>([voterSecret, 1]);
  assert(!voting.nullifiers.member(nullifier), "Already voted");
  voting.nullifiers.insert(nullifier);
  if (!voting.proposals.member(proposalId)) {
    voting.proposals.insert(proposalId, default<Counter>);
  }
  voting.proposals.lookup(proposalId).increment(1);
}