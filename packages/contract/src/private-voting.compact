import CompactStandardLibrary;

export ledger proposals: Map<Field, Counter>;
export ledger voterCommitments: MerkleTree<20, Field>;
export ledger nullifiers: Set<Field>;
export ledger votingOpen: Boolean;

constructor(open: Boolean) {
  votingOpen = open;
}

export circuit registerVoter(voterSecret: Field): [] {
  assert(votingOpen, "Registration is closed");
  const commitment = transientHash<Field>(voterSecret);
  voterCommitments.insert(commitment);
}

export circuit castVote(
  voterSecret: Field,
  authPath: MerkleTreePath<20, Field>,
  proposalId: Field,
): [] {
  assert(votingOpen, "Voting is closed");
  const commitment = transientHash<Field>(voterSecret);
  const digest = merkleTreePathRoot<20, Field>(authPath);
  assert(voterCommitments.checkRoot(digest) == true, "Voter not registered");
  const nullifier = transientHash<Vector<2, Field>>([voterSecret, 1]);
  assert(!nullifiers.member(nullifier), "Already voted");
  nullifiers.insert(nullifier);
  if (!proposals.member(proposalId)) {
    proposals.insert(proposalId, default<Counter>);
  }
  proposals.lookup(proposalId).increment(1);
}